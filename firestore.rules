rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function member(householdId) {
      return get(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid)).data;
    }

    function isMember(householdId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid));
    }

    function isParent(householdId) {
      return isMember(householdId) && member(householdId).role == 'parent';
    }

    match /households/{householdId} {
      allow read: if isMember(householdId);
      allow write: if isParent(householdId);

      // Family roster — only parents manage roles/members (prevents self-promotion to parent)
      match /members/{memberId} {
        allow read: if isMember(householdId);
        allow write: if isParent(householdId);
      }

      // Transaction categories — everyone views, only parents edit
      match /categories/{categoryId} {
        allow read: if isMember(householdId);
        allow write: if isParent(householdId);
      }

      // Debts — everyone views, only parents edit
      match /debts/{debtId} {
        allow read: if isMember(householdId);
        allow write: if isParent(householdId);
      }

      // Transactions — everyone views and logs their own; parents can edit/delete any
      match /transactions/{txId} {
        allow read: if isMember(householdId);
        allow create: if isMember(householdId) &&
          (request.resource.data.memberId == request.auth.uid || isParent(householdId));
        allow update, delete: if isParent(householdId) ||
          (isMember(householdId) && resource.data.memberId == request.auth.uid);
      }

      // Savings accounts — parents only (hidden from kids' nav and data)
      match /goals/{goalId} {
        allow read, write: if isParent(householdId);
      }

      // Private net-worth section — parents only, full stop
      match /savingsAccounts/{accountId} {
        allow read, write: if isParent(householdId);
      }
      match /assets/{assetId} {
        allow read, write: if isParent(householdId);
      }
      match /passiveIncome/{entryId} {
        allow read, write: if isParent(householdId);
      }
      match /insurancePolicies/{policyId} {
        allow read, write: if isParent(householdId);
      }

      // Weekly meal plan — everyone in the household views and edits
      match /mealPlan/{docId} {
        allow read, write: if isMember(householdId);
      }

      // Weekly chores — everyone in the household views and checks off their own
      match /chores/{docId} {
        allow read, write: if isMember(householdId);
      }

      // Budget Watchdog digest — everyone views; only the server (Admin SDK,
      // which bypasses rules) writes it
      match /watchdog/{docId} {
        allow read: if isMember(householdId);
        allow write: if false;
      }

      // Office day tracking — parents only
      match /officeDays/{docId} {
        allow read, write: if isParent(householdId);
      }

      // Family appointments (doctor, dentist, etc.) — parents only
      match /appointments/{appointmentId} {
        allow read, write: if isParent(householdId);
      }

      // Passport/visa/license expiry tracking — parents only
      match /familyDocuments/{docId} {
        allow read, write: if isParent(householdId);
      }

      // Growth/vitals log — parents only
      match /vitals/{entryId} {
        allow read, write: if isParent(householdId);
      }
    }
  }
}
